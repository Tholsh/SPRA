paint-waste.exe
/build/
# Keep BPE intermediates out of commits; compressed .bpe.xz files stay eligible.
*.spbe
*.exe
*.dll
*.o
*.obj
*.a
*.lib
*.pdb
*.ilk

# Keep N > 10 superpermutations compressed.
/words/1[1-9]/**/*.txt
/words/[2-9][0-9]/**/*.txt
/words/[1-9][0-9][0-9]*/**/*.txt
superpermutation-1[1-9]-*.txt
superpermutation-[2-9][0-9]-*.txt
superpermutation-[1-9][0-9][0-9]*-*.txt

# Local Python bytecode.
__pycache__/
*.py[cod]
